# Required — Base64-encoded 256-bit key for JWT signing (no default)
JWT_SECRET=<base64-encoded-256-bit-key>

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ia_aggregator
DB_USERNAME=ia_aggregator
DB_PASSWORD=ia_aggregator

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_RPH=600
